{
  "name": "@dunbackmeadow/commerce-sdk",
  "version": "0.3.0",
  "description": "Official Node.js/TypeScript SDK for the Dunback Meadow commerce API. Order from your app or agent and pay by card (Stripe) or USDC. Event catering is available now; more product types are coming.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DunbackMeadow/commerce-sdk.git"
  },
  "homepage": "https://dunbackmeadow.com/developer",
  "bugs": {
    "url": "https://github.com/DunbackMeadow/commerce-sdk/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/react/index.tsx --format esm --dts --clean --external react",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dunback-meadow",
    "catering",
    "luma",
    "events",
    "food-delivery",
    "x402",
    "usdc",
    "stripe",
    "agents"
  ],
  "author": "Dunback Meadow",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
